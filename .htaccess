RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^$ index.php [L,QSA]
RewriteRule ^home/?$ pages/home.php [L,QSA]
RewriteRule ^shop/?$ pages/shop.php [L,QSA]
RewriteRule ^login/?$ pages/login.php [L,QSA]
RewriteRule ^register/?$ pages/register.php [L,QSA]
RewriteRule ^cart/?$ pages/cart.php [L,QSA]
RewriteRule ^checkout/?$ pages/checkout.php [L,QSA]
RewriteRule ^orders/?$ pages/orders.php [L,QSA]
RewriteRule ^logout/?$ actions/logout.php [L,QSA]
RewriteRule ^product/([0-9]+)/?$ pages/product.php?id=$1 [L,QSA]
RewriteRule ^admin/?$ admin/dashboard.php [L,QSA]
RewriteRule ^admin/products/?$ admin/products.php [L,QSA]
RewriteRule ^admin/products/add/?$ admin/add_product.php [L,QSA]
RewriteRule ^admin/orders/?$ admin/manage_orders.php [L,QSA]
RewriteRule ^admin/users/?$ admin/manage_users.php [L,QSA]
